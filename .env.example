# =====================================================================
# .env 템플릿 — 당일 프로젝트 루트에 `.env` 라는 이름으로 저장한다
# =====================================================================
#
# ★★★ 당일 필수 3개: OPENROUTER_API_KEY · QDRANT_URL · QDRANT_API_KEY ★★★
#   질의 임베딩·BM25·리랭킹은 로컬에서 실행되므로 외부 서비스는 OpenRouter 와 Qdrant 둘뿐이다.
#
# ★★★ 출발 전 반드시 할 일 ★★★
#   아래 <...> 자리를 실제 키로 채워라. 비어 있는 상태로 가져가면 당일에 콘솔에
#   로그인해 재발급해야 한다(2분, 계정 로그인 수단 필수).
#   → 채우지 않고 가려면 OpenRouter·Qdrant Cloud 계정의 로그인 정보를 반드시 확보할 것.
#      재발급 절차는 `00_API_모음.md` 8절 참조.
#
# ⚠ 이 파일에 키를 채운 뒤에는 절대 git 에 커밋하지 말 것 (.gitignore 에 `.env` 추가).
# ⚠ 키를 채운 USB 를 분실하면 유출로 간주하고 즉시 폐기·재발급할 것.
# =====================================================================


# ---------------------------------------------------------------------
# 1. OpenRouter — 답변 생성 LLM (★ 필수)
#    발급: https://openrouter.ai/settings/keys
#    잔액: https://openrouter.ai/credits
#    형식: sk-or-v1-...
#    확정 모델: google/gemini-3.1-flash-lite
# ---------------------------------------------------------------------
OPENROUTER_API_KEY=<여기에 OpenRouter 키>


# ---------------------------------------------------------------------
# 2. Qdrant Cloud — 벡터 DB (★ 필수, 사전 구축 색인 재사용)
#    콘솔: https://cloud.qdrant.io
#    리전: GCP australia-southeast1 (호주 시드니)
#    컬렉션: material_rag / 6,901 points / dense 1024차원
#
#    URL 은 클러스터 고유 주소다(아래 값 그대로 사용).
#    API 키는 콘솔 → 클러스터 → API Keys 에서 발급한다.
#    ★ 가능하면 manage 권한 대신 '읽기전용' 키를 발급해 쓸 것.
#    ★ 무료 티어는 장기 미사용 시 정지된다. 해커톤 1~2일 전에 접속해 살려 둘 것.
# ---------------------------------------------------------------------
QDRANT_URL=<클러스터 고유 주소>
QDRANT_API_KEY=<여기에 Qdrant 키>


# ---------------------------------------------------------------------
# 3. HuggingFace 모델 캐시 (키 불필요)
#    당일 필요한 모델 2개 (합 2.7GB):
#      BAAI/bge-m3                                  ← 질의 임베딩 (★ 색인을 만든 모델)
#      cross-encoder/mmarco-mMiniLMv2-L12-H384-v1   ← 리랭킹
#    ★ HF_HOME 이 아니라 HF_HUB_CACHE 다.
#      (HF_HOME 은 하위에 hub/ 를 더 만들어 경로가 어긋난다)
#    HF_HUB_OFFLINE: 모델을 미리 반입했으면 1, 당일 다운로드하려면 0
# ---------------------------------------------------------------------
HF_HUB_CACHE=./models
HF_HUB_OFFLINE=0


# ---------------------------------------------------------------------
# 4. 자체 서버 접근 토큰 (서버를 0.0.0.0 으로 노출할 때 필수)
#    /api/* 호출에 X-API-Token 헤더를 요구한다. (/api/health 와 화면은 열려 있다)
#    생성: python -c "import secrets; print(secrets.token_urlsafe(24))"
#    ⚠ 해커톤 현장 네트워크는 공용이다. 비워두고 0.0.0.0 바인딩하면
#      같은 네트워크의 누구나 사내 문서를 질의할 수 있다.
# ---------------------------------------------------------------------
RAG_API_TOKEN=<python -c \"import secrets; print(secrets.token_urlsafe(24))\">


# ---------------------------------------------------------------------
# 5. 텔레메트리 차단 (사내 보안 권장)
# ---------------------------------------------------------------------
ANONYMIZED_TELEMETRY=False


# =====================================================================
# 아래는 백업용 (없어도 챗봇은 동작한다)
# =====================================================================

# --- Google AI Studio (Gemini 직접 호출) ---
#     발급: https://aistudio.google.com/apikey
#     ⚠ 무료 티어는 모델당 하루 20회 한도. 시연용 단발 백업으로만.
GOOGLE_API_KEY=

# --- NVIDIA Build (NIM) — 가장 빠르지만 인용 밀도가 낮다 ---
#     발급: https://build.nvidia.com/
NVIDIA_API_KEY=

# --- Anthropic API — 지시 준수 강함. OpenRouter 경유로도 같은 모델 사용 가능 ---
#     발급: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Windows 심볼릭 링크 권한 없음 → 캐시를 복사 방식으로
HF_HUB_DISABLE_SYMLINKS=1
